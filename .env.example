# Runtime workdir defaults to ~/.cag (built-in)

# Optional startup overrides
CHANNEL_TYPE=command
ACP_AGENT_CMD=codex-acp

# Optional command channel overrides
SMS_FETCH_CMD="printf '[]'"
SMS_SEND_CMD="/bin/true"
REMOTE_USER_ID=tester
ALLOWED_FROM=tester

# Optional iMessage startup overrides
IMESSAGE_FETCH_CMD="imsg fetch --json"
IMESSAGE_SEND_CMD="imsg send"

# Storage and paths
# Runtime paths are fixed under ~/.cag/runtime/repos/<repo-id>/ and not configurable via .env.
STORAGE_BACKEND=sqlite
