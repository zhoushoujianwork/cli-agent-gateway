# Startup-only config. Runtime tuning should use:
#   cd src && go run ./cmd/gateway-cli config set <KEY> <VALUE>

# Optional startup overrides
CHANNEL_TYPE=command
ACP_AGENT_CMD=codex-acp

# Optional command channel overrides
SMS_FETCH_CMD="printf '[]'"
SMS_SEND_CMD="/bin/true"
REMOTE_USER_ID=tester
ALLOWED_FROM=tester

# Optional iMessage startup overrides
IMESSAGE_FETCH_CMD="imsg fetch --json"
IMESSAGE_SEND_CMD="imsg send"

# Optional storage/path overrides (defaults are hardcoded)
STORAGE_BACKEND=sqlite
STORAGE_SQLITE_PATH=.agent_gateway.db
LOCK_FILE=.cli_agent_gateway.lock
STATE_FILE=.agent_gateway_state.json
REPORT_DIR=.agent_gateway_reports
INTERACTION_LOG_FILE=.agent_gateway_interactions.jsonl

# User-level DingTalk / gatewayd config should go to ~/.cag/.env via:
#   cd src && go run ./cmd/gateway-cli config set DINGTALK_APP_KEY your-key --global
#   cd src && go run ./cmd/gateway-cli config set GATEWAYD_ADDR 127.0.0.1:58473 --global
